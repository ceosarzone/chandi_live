APP_NAME="CHANDI.LIVE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8091
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chandi_live
DB_USERNAME=chandi_user
DB_PASSWORD=
# Optional XAMPP local socket; leave empty on TCP / cPanel.
DB_SOCKET=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@chandi.live"
MAIL_FROM_NAME="CHANDI.LIVE"
MARKET_PROVIDER=disabled
MARKET_DEMO=false
METALS_DEV_API_KEY=
MARKET_LICENSE_CONFIRMED=false
MARKET_STALE_MINUTES=180
MARKET_FX_STALE_HOURS=48
MARKET_CACHE_SECONDS=60
MARKET_FAILURE_NOTIFY_AFTER=3
MARKET_ADMIN_EMAIL=
# Comma-separated trusted reverse-proxy IPs, only when your host requires them.
TRUSTED_PROXIES=
VITE_APP_NAME="${APP_NAME}"

# Initial launch: market charts only; retained dealer workflows are paused.
MARKETPLACE_ENABLED=false
